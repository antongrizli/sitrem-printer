{
  "name": "sitrem-printer",
  "version": "0.1.13",
  "description": "Secure SITREM desktop connector for system label printers",
  "author": "SITREM",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build": "npm run typecheck && npm test && electron-vite build",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && node ./scripts/package-win.mjs",
    "run:local": "npm start"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/css-tree": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@bwip-js/node": "^4.11.4",
    "css-tree": "^3.2.1",
    "parse5": "^8.0.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "electron-vite": {
      "vite": "$vite"
    }
  },
  "build": {
    "appId": "com.sitrem.printer",
    "productName": "SitremPrinter",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "src/assets/sitrem-icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
